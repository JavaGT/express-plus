{
	"name": "workbench",
	"version": "0.1.3",
	"description": "Workbench for collaborative, persisted, realtime data.",
	"type": "module",
	"main": "build/index.mjs",
	"types": "index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./build/index.mjs"
		},
		"./client": {
			"types": "./client.d.ts",
			"default": "./public/workbench-client.mjs"
		},
		"./server": {
			"types": "./src/server.d.ts",
			"default": "./build/server.mjs"
		},
		"./annotated-text": {
			"types": "./annotated-text.d.ts",
			"default": "./build/annotated-text-public.mjs"
		},
		"./annotated-text-coords": {
			"types": "./annotated-text-coords.d.ts",
			"default": "./public/workbench-annotated-text-coords.mjs"
		}
	},
	"scripts": {
		"emit:ts": "node --disable-warning=ExperimentalWarning scripts/emit-ts.mjs",
		"build": "pnpm emit:ts",
		"lint": "eslint .",
		"test": "pnpm emit:ts && node scripts/run-tests.mjs",
		"bench": "node bench/hot-path.mjs",
		"bench:quick": "node bench/hot-path.mjs --sizes small --samples 3",
		"bench:compile": "node bench/hot-path.mjs --benchmarks compile",
		"bench:http": "node bench/hot-path.mjs --benchmarks http-crud",
		"bench:commit": "node bench/hot-path.mjs --benchmarks commit",
		"bench:live": "node bench/hot-path.mjs --benchmarks live-delivery",
		"bench:text": "node bench/hot-path.mjs --benchmarks annotated-text",
		"bench:profile": "node bench/hot-path.mjs --profile bench/workbench-performance.cpuprofile",
		"bench:compare": "node bench/hot-path.mjs --compare bench/baseline.json",
		"test:playwright": "playwright test",
		"test:coverage": "node scripts/check-coverage.mjs 0",
		"typecheck": "tsc --noEmit",
		"verify:concise": "pnpm lint && pnpm typecheck && pnpm test"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"@playwright/test": "^1.62.1",
		"eslint": "^9.39.5",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.7.0",
		"jsdom": "^29.1.1",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=22"
	}
}
