{
	"name": "workbench",
	"version": "0.1.2",
	"description": "Workbench for collaborative, persisted, realtime data.",
	"type": "module",
	"main": "src/index.mjs",
	"types": "index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./src/index.mjs"
		},
		"./client": {
			"types": "./client.d.ts",
			"default": "./public/workbench-client.mjs"
		},
		"./server": {
			"types": "./src/server.d.ts",
			"default": "./src/server.mjs"
		}
	},
	"scripts": {
		"lint": "eslint .",
		"test": "node --test",
		"test:coverage": "node --experimental-test-coverage --test",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"eslint": "^9.39.5",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.7.0",
		"jsdom": "^29.1.1",
		"svelte": "^5.56.4",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=22"
	}
}
